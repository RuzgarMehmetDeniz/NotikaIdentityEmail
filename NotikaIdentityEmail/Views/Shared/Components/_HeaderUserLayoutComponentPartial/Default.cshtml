<div class="header-top-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-4 col-sm-12 col-xs-12">
                <div class="logo-area">
                    <!-- Başına ~ işareti eklendi -->
                    <a href="/Message/Inbox/"><img src="~/notika-master/notika/green-horizotal/img/logo/logo.png" alt="" /></a>
                </div>
            </div>
            <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12">
                <div class="header-top-menu">
                    <ul class="nav navbar-nav notika-top-nav">

                        <!-- Arama Kutusu -->
                        <li class="nav-item dropdown">
                            <a href="#" data-toggle="dropdown" role="button" aria-expanded="false" class="nav-link dropdown-toggle"><span><i class="notika-icon notika-search"></i></span></a>
                            <div role="menu" class="dropdown-menu search-dd animated flipInX">
                                <div class="search-input">
                                    <i class="notika-icon notika-left-arrow"></i>
                                    <input type="text" />
                                </div>
                            </div>
                        </li>

                        <!-- Mesajlar Listesi Dropdown (Eğer component içinde <li> yoksa buraya aldık) -->
                        <li class="nav-item dropdown nc-al">
                            <a href="#" data-toggle="dropdown" role="button" aria-expanded="false" class="nav-link dropdown-toggle">
                                <span><i class="notika-icon notika-mail"></i></span>
                            </a>
                            @await Component.InvokeAsync("_MessageListOnNavbarHeaderComponentPartial")
                        </li>

                        <!-- Bildirimler Listesi Dropdown -->
                        <li class="nav-item nc-al">
                            <a href="#" data-toggle="dropdown" role="button" aria-expanded="false" class="nav-link dropdown-toggle">
                                <span><i class="notika-icon notika-alarm"></i></span>
                                <div class="spinner4 spinner-4"></div>
                                <div class="ntd-ctn"><span>@ViewBag.userEmailCount</span></div>
                            </a>
                            @await Component.InvokeAsync("_NotificationListOnNavbarComponentPartial")
                        </li>

                        <!-- Sağ Menü İkonu -->
                        <li class="nav-item">
                            <a href="/Message/Inbox/" role="button" aria-expanded="false" class="nav-link dropdown-toggle">
                                <span><i class="notika-icon notika-menus"></i></span>
                                <div class="spinner4 spinner-4"></div>
                                <div class="ntd-ctn"><span>@ViewBag.notificationCount</span></div>
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>